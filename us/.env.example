# Copy to .env (never commit .env). In production these are set in
# Shopify Admin → Hydrogen → Storefront → Environments and variables.
# This is the trenzora.com (US, USD) store — never the trenzora.in store.

# Required
SESSION_SECRET="generate-a-long-random-string"
PUBLIC_STORE_DOMAIN="<us-store>.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""
# Where Shopify checkout runs: trenzora.com while it still serves the Online
# Store; checkout.trenzora.com once Hydrogen takes trenzora.com.
PUBLIC_CHECKOUT_DOMAIN="checkout.trenzora.com"

# Optional / provided by Oxygen
PUBLIC_STOREFRONT_ID=""
SHOP_ID=""

# Tracking (optional; nothing loads when empty). Consent-gated.
PUBLIC_META_PIXEL_ID=""
PUBLIC_GA4_ID=""
PUBLIC_GOOGLE_ADS_ID=""

# "on" only after the SETUP-* discount codes exist in Shopify Admin
# (catalog/bundles.md). Off = bundles sell at the sum of their parts.
PUBLIC_BUNDLE_DISCOUNTS="off"
