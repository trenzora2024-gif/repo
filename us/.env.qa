# QA copy of .env.mock. Local preview against scripts/mock-storefront.ts (no Shopify store needed).
# Not secrets — safe to commit. Used by `npm run dev:mock`.
SESSION_SECRET="local-mock-only"
PUBLIC_STORE_DOMAIN="http://localhost:4200"
PUBLIC_STOREFRONT_API_TOKEN="00000000000000000000000000000000"
PRIVATE_STOREFRONT_API_TOKEN="mock-private-token"
PUBLIC_CHECKOUT_DOMAIN="localhost:4200"
PUBLIC_STOREFRONT_ID="1"
PUBLIC_BUNDLE_DISCOUNTS="on"
# QA only: fake IDs so scripts/qa-storefront.mjs can verify pixel events.
# The QA browser stubs fbevents.js / gtag.js — nothing is sent anywhere.
PUBLIC_META_PIXEL_ID="000000000000000"
PUBLIC_GA4_ID="G-QA0000000"
