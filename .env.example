# Copy to .env (never commit .env). In production these are set in
# Shopify Admin → Hydrogen → Storefront → Environments and variables.

# Required
SESSION_SECRET="generate-a-long-random-string"
PUBLIC_STORE_DOMAIN="trenzora.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""
# Where Shopify checkout runs. Defaults to checkout.trenzora.in when unset
# (app/lib/store-guard.ts).
PUBLIC_CHECKOUT_DOMAIN="checkout.trenzora.in"

# Optional / provided by Oxygen
PUBLIC_STOREFRONT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""
SHOP_ID=""
